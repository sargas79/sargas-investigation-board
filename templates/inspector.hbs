<aside class="ib-inspector">
    <h2 class="ib-panel-label">{{localize "INVESTIGATION_BOARD.SelectedClue"}}</h2>

    {{#if clue}}
        <div class="ib-inspector-body">
            <div class="ib-field">
                <input type="text" class="ib-clue-name-input" name="name" value="{{clue.name}}"
                       {{#unless clue.editable}}disabled{{/unless}}
                       aria-label="{{localize 'INVESTIGATION_BOARD.TitleLabel'}}">
            </div>

            {{#if clue.author}}
                <p class="ib-pinned-by">
                    <span class="ib-author-dot" style="--ib-author: {{clue.authorColor}}"></span>
                    <span class="ib-pinned-by-text">
                        {{#if clue.pinnedAt}}
                            {{localize "INVESTIGATION_BOARD.PinnedByAt" who=clue.author when=clue.pinnedAt}}
                        {{else}}
                            {{localize "INVESTIGATION_BOARD.PinnedBy" who=clue.author}}
                        {{/if}}
                    </span>
                    {{#if clue.canReassign}}
                        <button type="button" class="ib-icon-button ib-reassign-author" data-action="reassignAuthor"
                                data-tooltip="INVESTIGATION_BOARD.ReassignAuthor"
                                aria-label="{{localize 'INVESTIGATION_BOARD.ReassignAuthor'}}">
                            <i class="fa-solid fa-user-pen"></i>
                        </button>
                    {{/if}}
                </p>
            {{else if clue.canReassign}}
                {{!-- A clue pinned before bylines existed has nobody to credit until the GM names one. --}}
                <p class="ib-pinned-by">
                    <span class="ib-pinned-by-text">{{localize "INVESTIGATION_BOARD.NoAuthor"}}</span>
                    <button type="button" class="ib-icon-button ib-reassign-author" data-action="reassignAuthor"
                            data-tooltip="INVESTIGATION_BOARD.ReassignAuthor"
                            aria-label="{{localize 'INVESTIGATION_BOARD.ReassignAuthor'}}">
                        <i class="fa-solid fa-user-pen"></i>
                    </button>
                </p>
            {{/if}}

            {{!-- #63: a reassignment is never silent — what the credit said before stays on show. --}}
            {{#each clue.authorHistory}}
                <p class="ib-author-history">{{this}}</p>
            {{/each}}

            {{!-- What the GM has declared this clue evidence of. Public: the stamp is on the card too. --}}
            {{#if clue.stamps.length}}
                <p class="ib-inspector-stamps">
                    {{#each clue.stamps}}<span class="ib-stamp-chip">{{this}}</span>{{/each}}
                </p>
            {{/if}}

            <dl class="ib-inspector-meta">
                <dt>{{localize "INVESTIGATION_BOARD.CategoryLabel"}}</dt>
                <dd>
                    <select name="category" {{#unless clue.editable}}disabled{{/unless}}>
                        {{selectOptions categories selected=clue.category valueAttr="value" labelAttr="label"}}
                    </select>
                </dd>
                <dt>{{localize "INVESTIGATION_BOARD.ReliabilityLabel"}}</dt>
                <dd>
                    <select name="reliability" {{#unless clue.editable}}disabled{{/unless}}>
                        {{selectOptions reliabilities selected=clue.reliability valueAttr="value" labelAttr="label"}}
                    </select>
                </dd>
            </dl>

            {{#if clue.editable}}
                <div class="ib-inspector-actions">
                    <button type="button" data-action="linkFromSelected">
                        <i class="fa-solid fa-link"></i>
                        <span>{{localize "INVESTIGATION_BOARD.LinkClue"}}</span>
                    </button>
                    <button type="button" data-action="addNote">
                        <i class="fa-solid fa-note-sticky"></i>
                        <span>{{localize "INVESTIGATION_BOARD.AddNote"}}</span>
                    </button>
                </div>
            {{/if}}

            {{#if clue.linkedUuid}}
                <button type="button" class="ib-linked-doc" data-action="openLinked">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    <span>{{localize "INVESTIGATION_BOARD.OpenLinked"}}</span>
                </button>
            {{/if}}

            {{!-- GURPS Monster Hunters: the GM declares the clue, and the team's deductions are rolled. --}}
            {{#if deduce}}
                <section class="ib-inspector-section ib-deduce">
                    <h3 class="ib-panel-label">{{localize "INVESTIGATION_BOARD.DEDUCTIONS.Deduction"}}</h3>
                    <div class="ib-deduce-types">
                        {{#each deduce.types}}
                            <label class="ib-deduce-type">
                                <input type="checkbox" name="deduceType" value="{{this.type}}" {{#if this.checked}}checked{{/if}}>
                                <span>{{this.label}}</span>
                            </label>
                        {{/each}}
                    </div>
                    <div class="ib-deduce-row">
                        <select name="deduceWeight" aria-label="{{localize 'INVESTIGATION_BOARD.DEDUCTIONS.Weight'}}">
                            {{#each deduce.weights}}
                                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                        <input type="number" name="deduceBonus" step="1" value="{{deduce.bonus}}"
                               placeholder="{{localize 'INVESTIGATION_BOARD.DEDUCTIONS.Bonus'}}"
                               aria-label="{{localize 'INVESTIGATION_BOARD.DEDUCTIONS.Bonus'}}"
                               data-tooltip="INVESTIGATION_BOARD.DEDUCTIONS.BonusHint">
                    </div>
                    <label class="ib-deduce-roll">
                        <input type="checkbox" name="deduceRoll" checked>
                        <span>{{localize "INVESTIGATION_BOARD.DEDUCTIONS.RollNow"}}</span>
                    </label>
                    <div class="ib-inspector-actions">
                        <button type="button" data-action="stampClue">
                            <i class="fa-solid fa-stamp"></i>
                            <span>{{localize "INVESTIGATION_BOARD.DEDUCTIONS.Stamp"}}</span>
                        </button>
                        {{#if deduce.logged}}
                            <button type="button" class="ib-danger" data-action="unstampClue">
                                <i class="fa-solid fa-eraser"></i>
                                <span>{{localize "INVESTIGATION_BOARD.DEDUCTIONS.Unstamp"}}</span>
                            </button>
                        {{/if}}
                    </div>
                </section>
            {{/if}}

            {{!-- #25, #62: the clue's strings — the name walks to the clue, the scissors cut it. --}}
            <section class="ib-inspector-section">
                <h3 class="ib-panel-label">{{localize "INVESTIGATION_BOARD.Connections"}}</h3>
                {{#each connections}}
                    <div class="ib-connection-row" data-connection-id="{{this.id}}">
                        <span class="ib-connection-swatch" style="--ib-swatch: var(--ib-pin-{{this.color}})"></span>
                        <button type="button" class="ib-connection-name" data-action="goToClue"
                                data-clue-id="{{this.otherId}}"
                                data-tooltip="INVESTIGATION_BOARD.GoToClue"
                                aria-label="{{localize 'INVESTIGATION_BOARD.GoToClueNamed' name=this.otherName}}"
                                >{{this.otherName}}</button>
                        {{#if ../clue.editable}}
                            <button type="button" class="ib-icon-button ib-danger" data-action="cutConnection"
                                    data-connection-id="{{this.id}}"
                                    data-tooltip="INVESTIGATION_BOARD.CutString"
                                    aria-label="{{localize 'INVESTIGATION_BOARD.CutString'}}">
                                <i class="fa-solid fa-scissors"></i>
                            </button>
                        {{/if}}
                    </div>
                {{else}}
                    <p class="ib-empty">{{localize "INVESTIGATION_BOARD.NoConnections"}}</p>
                {{/each}}
            </section>

            {{#if clue.notes.length}}
                <section class="ib-inspector-section">
                    <h3 class="ib-panel-label">{{localize "INVESTIGATION_BOARD.Notes"}}</h3>
                    {{#each clue.notes}}
                        <article class="ib-note">
                            <p class="ib-note-text">{{this.text}}</p>
                            <p class="ib-note-by">{{this.byline}}</p>
                            {{#if this.canChange}}
                                <span class="ib-note-actions">
                                    <button type="button" class="ib-icon-button" data-action="editNote"
                                            data-note-author="{{this.author}}" data-note-time="{{this.time}}"
                                            data-tooltip="INVESTIGATION_BOARD.EditNote"
                                            aria-label="{{localize 'INVESTIGATION_BOARD.EditNote'}}">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button type="button" class="ib-icon-button ib-danger" data-action="deleteNote"
                                            data-note-author="{{this.author}}" data-note-time="{{this.time}}"
                                            data-tooltip="INVESTIGATION_BOARD.DeleteNote"
                                            aria-label="{{localize 'INVESTIGATION_BOARD.DeleteNote'}}">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </span>
                            {{/if}}
                        </article>
                    {{/each}}
                </section>
            {{/if}}

            {{#if clue.editable}}
                <footer class="ib-inspector-footer">
                    <button type="button" class="ib-dismiss-clue" data-action="dismissClue"
                            data-clue-id="{{clue.id}}">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>{{localize "INVESTIGATION_BOARD.Dismiss"}}</span>
                    </button>
                </footer>
            {{/if}}
        </div>
    {{else}}
        <div class="ib-inspector-body">
            <p class="ib-empty">{{localize "INVESTIGATION_BOARD.NoClueSelected"}}</p>
        </div>
    {{/if}}
</aside>

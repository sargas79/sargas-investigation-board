{
  "id": "sargas-investigation-board",
  "title": "Sargas - Investigation Board",
  "description": "A pinboard for collaborative investigation. Players pin clues, string them together, and work cases as a party — no GM required at the table.",
  "version": "1.5.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "authors": [
    {
      "name": "sargas79",
      "github": "sargas79"
    }
  ],
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/fonts.css",
    "styles/investigation-board.css",
    "styles/clue-cards.css",
    "styles/strings.css",
    "styles/dialogs.css",
    "styles/tray.css",
    "styles/inspector.css",
    "styles/filter.css",
    "styles/case-file.css",
    "styles/handouts.css",
    "styles/deductions.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "JournalEntryPage": {
      "clue": {
        "htmlFields": [
          "body"
        ],
        "filePathFields": {
          "image": [
            "IMAGE"
          ]
        }
      },
      "connection": {},
      "report": {
        "htmlFields": [
          "body"
        ]
      },
      "handout": {
        "htmlFields": [
          "body"
        ],
        "filePathFields": {
          "image": [
            "IMAGE"
          ]
        }
      }
    }
  },
  "socket": true,
  "url": "https://github.com/sargas79/sargas-investigation-board",
  "manifest": "https://github.com/sargas79/sargas-investigation-board/releases/latest/download/module.json",
  "download": "https://github.com/sargas79/sargas-investigation-board/releases/latest/download/module.zip",
  "readme": "https://github.com/sargas79/sargas-investigation-board/blob/main/README.md",
  "bugs": "https://github.com/sargas79/sargas-investigation-board/issues",
  "license": "LICENSE"
}
